NODE_ENV=local
PORT=3000
CORS_ORIGIN=http://localhost:3001
ENABLE_SWAGGER=true
ENABLE_NEWS_SCHEDULE=true
ENABLE_STARTUP_NEWS_FETCH=true

DATABASE_URL=postgresql://[NEON_USER]:[NEON_PASSWORD]@[NEON_DIRECT_HOST]/[DB_NAME]?sslmode=require&channel_binding=require

NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_NEWS_API_URL=https://openapi.naver.com/v1/search/news.json

ENABLE_RAG_INDEXING=false
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=160
OLLAMA_BASE_URL=http://localhost:11434

ENABLE_LOCAL_LLM_SUMMARY=false
LOCAL_LLM_MODEL=qwen3:1.7b
LOCAL_LLM_SUMMARY_MAX_INPUT=6000

NEWS_ADMIN_API_KEY=your-local-admin-key

OPEN_METEO_API_URL=https://api.open-meteo.com/v1
OPEN_METEO_AIR_QUALITY_API_URL=https://air-quality-api.open-meteo.com/v1
